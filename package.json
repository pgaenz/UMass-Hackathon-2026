{
  "name": "historai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "eval": "tsc -p eval/tsconfig.json && node eval/.build/eval/main.js",
    "eval:live": "tsc -p eval/tsconfig.json && node eval/.build/eval/main.js --live",
    "eval:db": "tsx eval/db.ts",
    "eval:e2e": "node eval/e2e.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx scripts/db-check.ts",
    "db:pool-check": "tsx scripts/db-pool-check.ts",
    "db:seed:test": "tsx scripts/seed-test-db.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.0",
    "nodemailer": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
