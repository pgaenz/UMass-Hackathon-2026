# PostgreSQL (plan D1). Locally this is the Docker Compose database from
# `docker compose up -d db`; both URLs are identical.
#
# In production (Neon), DATABASE_URL is the **pooled** connection string (the
# host contains `-pooler`) used by the running app, and DIRECT_URL is the
# **direct** connection used by `prisma migrate deploy` and backups. Keep them
# separate: migrations must not run through the pooler.
#
# Pool sizing: append `connection_limit=<n>` to the pooled URL. A long-lived
# Node host should pick a number that covers its concurrency (e.g. 5-10); a
# serverless host should use the Neon pooler with `connection_limit=1` and
# `pgbouncer=true`. Run `npm run db:pool-check` to see the peak backend count.
DATABASE_URL=postgresql://historai:historai@localhost:5432/historai?schema=public
DIRECT_URL=postgresql://historai:historai@localhost:5432/historai?schema=public

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required in production (plan D11): the app refuses to start without it.
# Session cookies hold an opaque random token and only its SHA-256 hash is
# stored in the database; this secret is reserved for future signing needs.
SESSION_SECRET=

# Email delivery for password reset / email verification (plan D6).
# In development, leave these empty: links are printed to the server console.
# In production SMTP_HOST and SMTP_FROM are required to send real email.
# Any SMTP provider works; Resend is the recommended default:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=re_...
#   SMTP_FROM="HistorAI <noreply@your-domain.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# DEV/TEST ONLY. Shared password that `npm run db:seed:test` assigns to the
# seeded users so the e2e harness can sign in as them. The script refuses to run
# with NODE_ENV=production.
SEED_USER_PASSWORD=historai-dev-password

# OpenRouter API base URL (optional)
BASE_URL=https://openrouter.ai/api/v1

# Models (optional — defaults shown)
# LLM_MODEL is the fallback for every agent. WRITING_MODEL and REVIEW_MODEL
# override it for just the article writer and the independent reviewer, so the
# reviewer can run on a different model than the writer.
LLM_MODEL=openai/gpt-4o-mini
WRITING_MODEL=openai/gpt-4o-mini
REVIEW_MODEL=google/gemini-3.6-flash
STT_MODEL=openai/whisper-large-v3-turbo
TTS_MODEL=google/gemini-3.8-flash-lite-tts

# Native speech-to-speech conversation (OpenRouter streams pcm16 audio only)
AUDIO_MODEL=openai/gpt-audio-mini
AUDIO_VOICE=sage
AUDIO_SAMPLE_RATE=24000
CONVERSATION_MAX_TURNS=12
CONVERSATION_MAX_AUDIO_HISTORY_TURNS=2
